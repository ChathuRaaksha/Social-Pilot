# Flask API Configuration
PORT=8080
FLASK_ENV=development
FLASK_DEBUG=True

# Temporal Configuration
TEMPORAL_HOST=localhost
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=social-post-queue

# Workflow Timeouts
RESULT_TIMEOUT_SECONDS=120
WORKFLOW_EXECUTION_TIMEOUT_SECONDS=3600

# Google Gemini AI
GOOGLE_GEMINI_API_KEY=your-gemini-api-key-here

# Social Media API Keys
# LinkedIn
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# X (Twitter)
X_API_KEY=your-x-api-key
X_API_SECRET=your-x-api-secret
X_ACCESS_TOKEN=your-x-access-token
X_ACCESS_TOKEN_SECRET=your-x-access-token-secret

# Database (if needed for persistence)
DATABASE_URL=postgresql://user:password@localhost:5432/social_pilot

# Supabase (for frontend integration)
SUPABASE_URL=your-supabase-url
SUPABASE_KEY=your-supabase-anon-key

# Mock Mode (set to true for testing without real API calls)
USE_MOCK_SERVICES=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
